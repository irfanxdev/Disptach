# =============================================================================
# Dispatch Backend — Environment Variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# --- Required (app won't start without these) ---

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/dispatch
# Atlas:  https://cloud.mongodb.com → Create free cluster → Connect → Drivers → copy URI
#         Replace <password> with your DB user password
MONGO_URI=mongodb://127.0.0.1:27017/dispatch

# Random secret for signing JWT auth tokens (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Must be exactly 32 characters — encrypts OAuth tokens stored in MongoDB
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Server ---

PORT=5000
NODE_ENV=development

# Frontend URL(s) for CORS and OAuth redirects (comma-separated if multiple)
# Local dev: http://localhost:5173
# Production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

JWT_EXPIRES_IN=7d

# --- Cloudinary (media uploads) ---
# Sign up: https://cloudinary.com → Dashboard shows Cloud Name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Meta (Facebook + Instagram) ---
# Register: https://developers.facebook.com → My Apps → Create App
# App ID & Secret: App Dashboard → Settings → Basic
# Redirect URI (add in Facebook Login settings):
#   Local:  http://localhost:5000/api/social/callback/facebook
#   Prod:   https://YOUR-BACKEND-DOMAIN/api/social/callback/facebook
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/social/callback/facebook

# --- X (Twitter) ---
# Register: https://developer.x.com → Projects & Apps → create app
# Client ID & Secret: App → Keys and tokens → OAuth 2.0
# Callback URL (in app settings):
#   Local:  http://localhost:5000/api/social/callback/x
#   Prod:   https://YOUR-BACKEND-DOMAIN/api/social/callback/x
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5000/api/social/callback/x

# --- LinkedIn ---
# Register: https://www.linkedin.com/developers/apps → Create app
# Client ID & Secret: App → Auth tab
# Redirect URL:
#   Local:  http://localhost:5000/api/social/callback/linkedin
#   Prod:   https://YOUR-BACKEND-DOMAIN/api/social/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/social/callback/linkedin

# --- Pinterest ---
# Register: https://developers.pinterest.com/apps/
# App ID & Secret: App dashboard
# Redirect URI:
#   Local:  http://localhost:5000/api/social/callback/pinterest
#   Prod:   https://YOUR-BACKEND-DOMAIN/api/social/callback/pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:5000/api/social/callback/pinterest
